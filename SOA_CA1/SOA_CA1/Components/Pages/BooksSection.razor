@page "/Books"
@page "/"
@using SOA_CA1.Services.Interfaces
@using SOA_CA1.Clients.Models
@inject IGoogleBooksService service
@inject Blazored.SessionStorage.ISessionStorageService sessionStorage
@inject NavigationManager NavigationManager
@inject UserSession userSession

<SOA_CA1.Components.Layout.HeaderLayout/>
<div class="search-container">

    <h3>Books Section</h3>
    <div class="search-bar">
        <input class="search-input" placeholder="Search here ..." @bind="searchQuery" />
        <button class="search-button" @onclick="CallAPI">Search</button>

        <button class="sort-button" @onclick="SortByAlphabet">
            Sort @if (isAscending)
            {
                <span>Ascending</span>
            }
            else
            {
                <span>Descending</span>
            }
        </button>

        <button class="sort-button" @onclick="SortByDate"> Sort by Date </button>

    </div>
</div>

@if (searched)
{
    @if (result == null)
    {
        <p>Loading Books...</p>
    }
    else if (result.Books == null)
    {
        <p>No Books Found</p>
    }
    else
    {
        <div class="book-container">
            @foreach (Book volume in result.Books)
            {
                <div class="book-card">
                    <img src="@volume.VolumeInfo.ImageLinks?.Thumbnail" alt="@volume.VolumeInfo.Title" class="book-image" />
                    <div class="book-info">
                        <h4>@(volume.VolumeInfo.Title ?? "Title not available")</h4>
                        <p>Authors: @(volume.VolumeInfo.Authors != null ? string.Join(", ", volume.VolumeInfo.Authors) : "Authors not available")</p>
                        <p> Published Year: @(volume.VolumeInfo.PublishedDate ?? "Not Available")</p>
                        <a href="/Books/@volume.Id?categories=@(volume.VolumeInfo.Categories != null ? Uri.EscapeDataString(string.Join(",", volume.VolumeInfo.Categories)) : "null")" class="btn">Select</a>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private GoogleBooksResponseModel result;
    private string searchQuery = "";
    private bool searched = false;
    private bool isAscending = true;
    private bool isDateAscending = true;
    public int currentPage = 1;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("You are logged in : " + userSession.Username);
        if (!userSession.IsLoggedIn)
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    public async Task CallAPI()
    {
        searched = true;
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            searchQuery = "flower";
        }

        var newResult = await service.SearchAsync(searchQuery);
        if (newResult != null)
        {
            result = newResult;
        }
    }

    private async Task SortByAlphabet()
    {
        if (result != null && searched)
        {
            var newResult = service.SortBooksAlphabet(isAscending);
            if(newResult != null)
            {
                result = newResult;
            }
            isAscending = !isAscending;
        }

    }

    private async Task SortByDate()
    {
        if (result != null && searched)
        {
            var newResult = service.SortBooksByDate(isDateAscending);
            if(newResult != null)
            {
                result = newResult;
            }
            isDateAscending = !isDateAscending;
        }
    }
}
