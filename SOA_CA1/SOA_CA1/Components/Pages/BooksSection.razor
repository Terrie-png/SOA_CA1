@page "/Books"
@using SOA_CA1.Services.Interfaces
@inject  IGoogleBooksService service
@using SOA_CA1.Clients.Models
<h3>BooksSection</h3>

<input placeholder="Search here ... " @bind=searchQuery />
<button @onclick="CallAPI">Search</button>

@if (searched)
{
	@if(result == null)
	{
		<p>Loading Books...</p>
	}
	else if (result.Books.Count == 0|| result.Books == null)
	{
		<p>No Books Found</p>
		@result.TotalItems
	}
	else
	{
		@result.Books.Count
		<ul>
			@foreach (Book volume in result.Books)
			{
				<li>
					<h4>@(volume.VolumeInfo.Title ?? "Title not available")</h4>
					<p>Authors: @(volume.VolumeInfo.Authors != null ? string.Join(", ", volume.VolumeInfo.Authors) : "Authors not available")</p>
					<p>Description: @(volume.VolumeInfo.Description ?? "Description not available")</p>
				</li>
			}
		</ul>
	
	}
}

@code {
	private GoogleBooksResponseModel result;
	private GoogleBooksResponseModel cache;
	private List<Book> books;
	private string searchQuery = "";
	private bool searched = false;

	protected override async Task OnInitializedAsync()
	{
	}

	public async Task CallAPI()
	{
		if (searchQuery == "")
		{
			searchQuery = "life";
		}
		result = await service.SearchBooksAsync(searchQuery);
		cache = result;
		books = cache.Books;
		var query = from VolumeInfo in books where VolumeInfo.VolumeInfo.Title
	}

	public async void RedirectToBookPage()
	{
		
	}

}
