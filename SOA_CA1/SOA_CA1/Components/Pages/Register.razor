@page "/Register"

@using SOA_CA1.Services.Interfaces
@inject IUserService userService

<h3>Register</h3>

<div>
    <label>Username:</label>
    <input @bind="username" />
</div>
<div>
    <label>Password:</label>
    <input @bind="password" type="password" />
</div>
<div>
    <label>Email:</label>
    <input @bind="email" type="email" />
</div>
<div>
    <label>Gender:</label>
    <select @bind="gender">
        <option value="Male">Male</option>
        <option value="Female">Female</option>
    </select>
</div>

<button @onclick="Register">Register</button>

@if (registrationFailed)
{
    <p style="color:red;">Registration failed. Username already exists.</p>
}
@if (registrationSuccess)
{
    <p style="color:green;">Registration successful! You can now login.</p>
}

@code {
    private string username;
    private string password;
    private string email;
    private string gender = "Male";  // Default selection
    private bool registrationFailed = false;
    private bool registrationSuccess = false;

    private void Register()
    {
        if (userService.RegisterUser(username, password, email, gender))
        {
            registrationSuccess = true;
            registrationFailed = false;
        }
        else
        {
            registrationFailed = true;
            registrationSuccess = false;
        }
    }
}
